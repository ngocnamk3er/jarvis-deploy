    "/api/v1/files/reindex": {
      "post": {
        "description": "Re-run the ingest pipeline (extract → chunk → embed → index) over\nexisting files — for after an embedding-model change or to recover\nfailed rows. Internal/admin only. Fire-and-forget: each file is reset\nto \"pending\" and its message queued through the outbox in the same\ntransaction (see repository.reindex_files), for jarvis-ocr-worker to\npick up exactly like a brand new upload. This returns as soon as\neverything is queued, not once it is processed. Omit user_id to reindex\neveryone's.",
        "operationId": "reindex_api_v1_files_reindex_post",
        "parameters": [
          {
            "in": "query",
            "name": "user_id",
