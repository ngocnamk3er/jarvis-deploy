    "/api/v1/files/nodes/{node_id}/content": {
      "get": {
        "description": "Raw bytes, for preview (inline) and download in the frontend — the\nfrontend fetches this with the browser's Authorization header attached\nand turns it into a blob URL itself; the Content-Disposition here is\njust a filename hint, not what decides preview vs. download (that's a\nfrontend-side choice: <img>/<iframe> the blob vs. <a download>).",
        "operationId": "get_node_content_api_v1_files_nodes__node_id__content_get",
        "parameters": [
          {
            "in": "path",
            "name": "node_id",
            "required": true,
            "schema": {
              "title": "Node Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "user_id",
